# 数据库配置 - TiDB Cloud
DB_HOST=your-tidb-host.tidbcloud.com
DB_PORT=4000
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=energy_management

# SSL 证书配置（TiDB Cloud 需要）- 使用相对路径
SSL_CA=./certs/ca-cert.pem

# 应用配置
APP_NAME=建筑能源管理系统
APP_VERSION=1.0.0
DEBUG=True

# 阿里云短信配置
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_SMS_SIGN_NAME=your_sms_sign_name
ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxxxx

# LLM API 配置
# 方案 1: RAGFlow (当前有问题，返回固定模板)
# LLM_API_BASE_URL=your_ragflow_base_url
# LLM_API_KEY=your_ragflow_api_key
# LLM_MODEL=your_ragflow_model
# RAGFLOW_CHAT_ID_MAIN=your_ragflow_chat_id_main
# RAGFLOW_CHAT_ID_ALT=your_ragflow_chat_id_alt

# 方案 2: DeepSeek (真实 AI，推荐使用)
DEEPSEEK_API_KEY=sk-your_deepseek_api_key
